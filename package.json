{
  "name": "black-market",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "BLACK MARKET — original 5x4 slot game prototype (virtual demo credits only)",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
